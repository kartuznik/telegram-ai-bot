TELEGRAM_BOT_TOKEN=your_telegram_bot_token
OPENAI_API_KEY=your_openai_api_key
TAVILY_API_KEY=your_tavily_api_key
ADMIN_ID=
# Этап 1: консьерж и якоря выключены; autofetch выключен (ручной редактор)
CONCIERGE_ENABLED=false
ANCHORS_ENABLED=false
PREF_AUTO_ENABLED=0
CONTENT_EDITOR_AUTOFETCH_ENABLED=false
TAVILY_FRESHNESS_DAYS=2
PROXY_HOST=
PROXY_PORT=
PROXY_USERNAME=
PROXY_PASSWORD=
TELEGRAM_PROXY_HOST=
TELEGRAM_PROXY_PORT=
TELEGRAM_PROXY_USERNAME=
TELEGRAM_PROXY_PASSWORD=
# Root logger level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Авто-повтор при слабом черновике (макс. 2 попытки)
AUTO_RETRY_WEAK_DRAFTS=false

# --- Предпочтения по категориям (обучение на фидбеке) ---
# Вес строки i в окне: decay^i (самая свежая — i=0). Меньше = быстрее забываем старые сигналы.
FEEDBACK_DECAY_RATE=0.88
# Сколько последних записей draft_feedback учитывать в окне preference / подсчётах по категории.
FEEDBACK_WINDOW_SIZE=20
# Минимум отзывов по категории в окне, чтобы применять буст/штраф preference (иначе pref_mult=1.0).
FEEDBACK_MIN_COUNT_FOR_FULL_PREF=3
# Зарезервировано (0 = не используется): доля веса при малом числе отзывов.
FEEDBACK_LOW_COUNT_SCALE=0.0
# Максимум |delta| к pref_mult от preference: pref_mult = 1 + clamp(gain_per_unit * pref_raw, ±max).
FEEDBACK_PREF_MAX_GAIN=0.10
FEEDBACK_PREF_GAIN_PER_UNIT=0.15
# Бонус если категория кандидата не встречалась среди последних NOVELTY_RECENT_DRAFTS черновиков: mult *= 1+bonus.
FEEDBACK_NOVELTY_BONUS=0.05
NOVELTY_RECENT_DRAFTS=10

# --- Разнообразие (diversity) при подборе черновика ---
DIVERSITY_SAME_CATEGORY_WINDOW=3
DIVERSITY_SAME_CATEGORY_PENALTY=0.30
DIVERSITY_NARROW_MIX_WINDOW=5
DIVERSITY_NARROW_MIX_CATEGORIES=2
DIVERSITY_OTHER_CATEGORIES_BONUS=0.20

# Домены для блокировки в поиске (через запятую). Пустая строка — отключить блокировку по этому списку.
BLOCKED_SEARCH_DOMAINS=tiktok.com,pornhub.com
# Если 1: после сбоев прокси у Telegram-бота однократно переключиться на прямой API.
# Используется только если задан TELEGRAM_PROXY_HOST.
TELEGRAM_PROXY_FALLBACK_DIRECT=
